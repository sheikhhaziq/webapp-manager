{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2022",
    "lib": [
      "ES2024"
    ],
    "outDir": "dist",
    "strict": true,
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "@config/*": ["./config/*"],
    },
    "jsx": "react-jsx",
    "jsxImportSource": "gnim/gtk4"
  }
}